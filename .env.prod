# =============================================================
# 生产环境配置
# =============================================================

POSTGRES_HOST=your_prod_db_host
POSTGRES_PORT=5432
POSTGRES_DB=offer_mate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_prod_password

# 生产环境：使用 validate 或 none，禁止自动建表
SPRING_JPA_DDL_AUTO=validate

REDIS_HOST=your_prod_redis_host
REDIS_PORT=6379

AI_BAILIAN_API_KEY=your_api_key_here
AI_MODEL=qwen-plus

# 生产环境：手动管理 schema，不自动初始化
AI_VECTORSTORE_INITIALIZE_SCHEMA=false

APP_AI_STRUCTURED_MAX_ATTEMPTS=2
APP_AI_STRUCTURED_INCLUDE_LAST_ERROR=true

APP_AI_RAG_REWRITE_ENABLED=true
APP_AI_RAG_SHORT_QUERY_LENGTH=4
APP_AI_RAG_TOPK_SHORT=20
APP_AI_RAG_TOPK_MEDIUM=12
APP_AI_RAG_TOPK_LONG=8
APP_AI_RAG_MIN_SCORE_SHORT=0.18
APP_AI_RAG_MIN_SCORE_DEFAULT=0.28

APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8

APP_STORAGE_ENDPOINT=http://your_prod_storage_host:9000
APP_STORAGE_ACCESS_KEY=your_prod_access_key
APP_STORAGE_SECRET_KEY=your_prod_secret_key
APP_STORAGE_BUCKET=offer-mate
APP_STORAGE_REGION=us-east-1

CORS_ALLOWED_ORIGINS=https://your-prod-domain.com

JWT_SECRET=54ee9d1e24ca57d99dad3ed1101b9604bcb656196181d2ee5b34ba3218cad5a2
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000
